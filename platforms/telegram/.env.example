# Запуск: bun run harvest  (через tsx/Node)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

SESSION_FILE=.telegram_session
# SOCKS для MTProto (или ALL_PROXY / системный GNOME manual socks)
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:10808
# TELEGRAM_USE_WSS=true
# TELEGRAM_PHONE=+79161234567
# TELEGRAM_FORCE_SMS=1   # если код не приходит в приложение Telegram (чат «Telegram»)

# CHANNELS_CONFIG_PATH=src/config/channels.json
# MATCHER_RULES_PATH=src/config/matcher-rules.json

LOG_FORMAT=json
LOG_LEVEL=info
MATCH_MODE=dual
DEBUG_DECISION_LOGS=false

RETRY_MAX_ATTEMPTS=4
RETRY_BASE_MS=700
RETRY_MAX_MS=10000

# Окно сбора вакансий (часы)
HARVEST_HOURS=24
HARVEST_MAX_PER_CHAT=300
# HARVEST_REPORT_PATH=logs/harvest-latest.json
# HARVEST_HISTORY_PATH=logs/harvest-history.jsonl

# Apply pipeline (phase 1: dry-run; phase 2: live queue + AUTO_APPLY)
APPLY_ENABLED=0
APPLY_DRY_RUN=1
# APPLY_ROOT=../apply
# AUTO_APPLY=0
# APPLY_BATCH_MAX=5
# TELEGRAM_WORK_HOUR_START=9
# TELEGRAM_WORK_HOUR_END=20
# TELEGRAM_CYCLE_MINUTES=120
# FORM_SUBMIT=1
# PLAYWRIGHT_ENABLED=1
# SMTP_* — см. platforms/apply/credentials.env (SSOT для worker)
