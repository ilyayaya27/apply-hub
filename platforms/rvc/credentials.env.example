# Скопируй в credentials.env и заполни. Не коммить credentials.env.

# --- Telegram job channels (public preview t.me/s/...) ---
RVC_CHANNEL=revacancy
RVC_GLOBAL_CHANNEL=revacancy_global

# preview = парсинг t.me/s (без логина); gramjs = user session как apply-hub/platforms/telegram
# TG_INGEST_MODE=preview
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_FILE=/home/alice/Documents/apply-hub/platforms/telegram/.telegram_session
# TELEGRAM_USE_WSS=false
# TG_GRAMJS_LIMIT=50
# TG_GRAMJS_MAX_AGE_HOURS=168
# TG_INGEST_FALLBACK_PREVIEW=true

# --- SSOT: письмо и резюме (read-only) ---
COVER_LETTER_PATH=/home/alice/Documents/apply-hub/letter.txt
RESUME_PATH=/home/alice/Documents/apply-hub/resume.pdf

# --- Фильтры и лимиты ---
MIN_FIT_SCORE=55
MAX_APPLIES_PER_DAY=8
MONITOR_INTERVAL_MIN=3

# false = только скан + уведомления в TG; true = авто form/email где возможно
AUTO_APPLY=false

# --- Уведомления в Telegram (бот) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Email-отклики (опционально) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# APPLY_FROM_EMAIL=
# APPLY_FROM_NAME=

# --- Form apply через Playwright (опционально, npm i playwright) ---
# PLAYWRIGHT_ENABLED=true
# PLAYWRIGHT_HEADLESS=true
# FORM_SUBMIT=false

# --- Пути БД (опционально) ---
# JOB_HUB_DB=/home/alice/Documents/rvc-applicant/job-hub.db
# STATE_PATH=/home/alice/Documents/rvc-applicant/state.json
