# Скопируй в credentials.env и заполни. SSOT для live email-apply и notify.
# telegram-worker.sh и telegram-harvest.sh source этот файл (APPLY_DRY_RUN, AUTO_APPLY, SMTP).
# APPLY_ENABLED=1 — только в platforms/telegram/.env (включить пайплайн).

# Live apply (0 = реальные отклики; по умолчанию в коде dry-run)
APPLY_DRY_RUN=1
AUTO_APPLY=0

# SMTP (Yandex / Gmail app password / свой relay)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APPLY_EMAIL=
APPLY_NAME="Ilya Silkin"

# Лимиты и задержки (anti-spam)
# APPLY_DELAY_MS_MIN=60000
# APPLY_DELAY_MS_MAX=180000
# MAX_APPLIES_PER_DAY=10
# MAX_FORM_APPLIES_PER_DAY=5
# MAX_EMAIL_APPLIES_PER_DAY=3
# TELEGRAM_WORK_HOUR_START=9
# TELEGRAM_WORK_HOUR_END=21
# APPLY_BATCH_MAX — в platforms/telegram/.env (3–5)

# Уведомления в Telegram (бот → личный chat_id)
# TELEGRAM_NOTIFY_BOT_TOKEN=
# TELEGRAM_NOTIFY_CHAT_ID=
# NOTIFY_ON=match,applied,failed,needs_human,daily_summary
