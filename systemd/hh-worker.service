[Unit]
Description=HH Applicant Tool — отклики, ответы, автоподнятие (8–21)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/apply-hub
ExecStartPre=%h/Documents/apply-hub/lib/wait-for-proxy.sh
ExecStart=%h/Documents/apply-hub/hh-worker.sh
Restart=on-failure
RestartSec=60
# Groq через openai_proxy_url; HH — напрямую
Environment=NO_PROXY=localhost,127.0.0.1

[Install]
WantedBy=default.target
