[Unit]
Description=LinkedIn Easy Apply orchestrator (hh-applicant-tool)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/hh-applicant-tool
ExecStart=%h/Documents/hh-applicant-tool/linkedin-worker.sh
Restart=on-failure
RestartSec=60
Environment=HOME=%h

[Install]
WantedBy=default.target
