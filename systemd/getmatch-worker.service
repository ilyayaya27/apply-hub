[Unit]
Description=GetMatch — auto-apply frontend vacancies via wizard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/apply-hub/platforms/apply
ExecStart=/usr/bin/node %h/Documents/apply-hub/platforms/apply/cli.js getmatch-apply 10
EnvironmentFile=%h/Documents/apply-hub/platforms/apply/credentials.env
StandardOutput=append:%h/Documents/apply-hub/logs/getmatch.log
StandardError=append:%h/Documents/apply-hub/logs/getmatch.log

[Install]
WantedBy=default.target
